# Normalise text files to LF in the repository.
* text=auto eol=lf

# Patches are applied byte-for-byte to an LF export of upstream; never let
# core.autocrlf rewrite them on Windows checkouts.
*.patch -text

# Windows-only helper scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.bin binary
