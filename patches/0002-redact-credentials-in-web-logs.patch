From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: satyaidk <nikadisatyanarayana@gmail.com>
Date: Fri, 23 Oct 2026 02:06:52 +0530
Subject: [PATCH 2/5] http_server: stop logging raw config and VPN query
 strings

The /config and /vpn handlers logged the full URL query at INFO level.
Those queries carry the STA and AP Wi-Fi passwords and the WireGuard
private and preshared keys, so every form submission copied the secrets
to the serial console and, when enabled, to the remote syslog server.

Log only the query size. The NVS getter already hides these keys via
is_secret_param(); this closes the remaining path. The /mappings and
firewall logs carry no secrets and are left unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 components/http_server/http_server.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/components/http_server/http_server.c b/components/http_server/http_server.c
index 1456850..b71732e 100644
--- a/components/http_server/http_server.c
+++ b/components/http_server/http_server.c
@@ -1603,7 +1603,8 @@ static esp_err_t config_get_handler(httpd_req_t *req)
             return ESP_ERR_NO_MEM;
         }
         if (httpd_req_get_url_query_str(req, buf, buf_len) == ESP_OK) {
-            ESP_LOGI(TAG, "Found URL query => %s", buf);
+            /* The query carries Wi-Fi passwords; log its size, never its content. */
+            ESP_LOGI(TAG, "Config form submitted (%u bytes)", (unsigned)strlen(buf));
             char reset_param[16];
             if (httpd_query_key_value(buf, "reset", reset_param, sizeof(reset_param)) == ESP_OK) {
                 esp_timer_start_once(restart_timer, 500000);
@@ -3541,7 +3542,8 @@ static esp_err_t vpn_get_handler(httpd_req_t *req)
     if (buf_len > 1) {
         buf = malloc(buf_len);
         if (buf != NULL && httpd_req_get_url_query_str(req, buf, buf_len) == ESP_OK) {
-            ESP_LOGI(TAG, "VPN query => %s", buf);
+            /* The query carries WireGuard keys; log its size, never its content. */
+            ESP_LOGI(TAG, "VPN form submitted (%u bytes)", (unsigned)strlen(buf));
 
             char param[128];
             bool has_config = false;
