# Setup credentials compiled into the firmware (sdkconfig syntax).
#
# 1. Create config/secrets.local (git-ignored) in one of two ways:
#      python tools/repeater.py init-secrets      (random passwords)
#    or copy this file to config/secrets.local and replace every REPLACE_ME.
# 2. Check it:  python tools/repeater.py check-secrets
#
# What the values do
#   SSID / AP password  The setup Wi-Fi the board broadcasts on first boot and
#                       after every factory reset. Join it to configure the
#                       board at http://192.168.4.1.
#   Admin password      Login for the web UI (and the remote console, if you
#                       enable it). Keep it different from the AP password:
#                       people you give Wi-Fi access should not be able to
#                       reconfigure the router.
#
# Rules (enforced at build time)
#   - SSID: 1-31 bytes, no control characters.
#   - Passwords: 8-63 printable ASCII characters, no double quote (") or
#     backslash (\), no leading or trailing space.
#   - Admin password: at most 127 bytes once URL-encoded (each symbol counts
#     as 3), because the web login field is 128 bytes.
#
# Both passwords can be changed later on the device ("Getting Started" page,
# set_ap, set_router_password). These build-time values only come back after a
# factory reset. The firmware image embeds them: never share build/ output.

CONFIG_REPEATER_SETUP_AP_SSID="ESP32-Repeater-Setup"
CONFIG_REPEATER_SETUP_AP_PASSWORD="REPLACE_ME_8_to_63_chars"
CONFIG_REPEATER_ADMIN_PASSWORD="REPLACE_ME_different_8_to_63_chars"
